{
  "name": "local-agent-orchestrator",
  "version": "0.1.0",
  "description": "Orquestrador local de agentes de programacao: Codex CLI supervisiona, Claude Code CLI executa.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:tests": "tsc -p tsconfig.test.json",
    "clean": "node -e \"const f=require('fs');for(const d of ['dist','dist-tests'])f.rmSync(d,{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.coordinator.json --noEmit && npm run -w apps/desktop typecheck",
    "pretest": "npm run build && npm run build:tests",
    "test": "node --test \"dist-tests/tests/**/*.test.js\"",
    "desktop": "npm run -w apps/desktop start",
    "desktop:build": "npm run -w apps/desktop build",
    "desktop:test": "npm run -w apps/desktop test:electron",
    "package:dir": "npm run -w apps/desktop package:dir",
    "package": "npm run -w apps/desktop package",
    "coordinator:build": "tsc -p tsconfig.coordinator.json",
    "coordinator:start": "npm run coordinator:build && node dist-coordinator/apps/coordinator/src/main.js"
  },
  "keywords": [
    "orchestrator",
    "codex",
    "claude-code",
    "cli"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "workspaces": [
    "apps/desktop",
    "apps/coordinator"
  ]
}
