{
  "name": "@ai-orchestrator/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Orchestrator desktop shell: Electron main, preload bridge and React renderer.",
  "main": "dist/apps/desktop/src/electron/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build && electron .",
    "test:electron": "npm run build && node scripts/run-electron-tests.mjs",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "package:dir": "npm run build && electron-builder --dir",
    "package": "npm run build && electron-builder --win nsis --publish never",
    "package:linux": "npm run build && electron-builder --linux dir"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "0.575.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.1.1",
    "@fontsource/manrope": "5.1.0",
    "@tailwindcss/cli": "4.2.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "electron": "44.1.1",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.10",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.3.4"
  },
  "author": "Arcanjo",
  "build": {
    "appId": "com.arcanjo.ai-orchestrator",
    "productName": "AI Orchestrator",
    "copyright": "Copyright \u00a9 2026 Arcanjo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AI-Orchestrator-Setup.${ext}",
      "executableName": "AI Orchestrator"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Orchestrator",
      "artifactName": "AI-Orchestrator-Setup.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Development",
      "executableName": "ai-orchestrator"
    },
    "asar": true,
    "npmRebuild": false,
    "publish": null
  }
}
